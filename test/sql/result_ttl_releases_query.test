# name: test/sql/result_ttl_releases_query.test
# description: expiring a cache must release the abandoned server-side query too, not just the rows it retained
# group: [sql]

include test/template/quack_setup.test_template

statement ok quack_db:quack_server_con
CREATE TABLE big AS SELECT range AS i, range::VARCHAR AS s FROM range(500000);

statement ok quack_db:quack_server_con
SET GLOBAL quack_enable_reconnects = true;

statement ok quack_db:quack_server_con
SET GLOBAL quack_cache_max_rows = 0;

statement ok quack_db:quack_server_con
SET GLOBAL quack_result_ttl = 1;

# Small batches and a small producer buffer, so the producer parks while the sort is still live.
# At the default sizes the whole result fits in the buffer. The query then completes before the
# client stalls, and no abandoned query remains to release.
statement ok quack_db:quack_server_con
SET GLOBAL quack_target_batch_bytes = 65536;

statement ok quack_db:quack_server_con
SET GLOBAL quack_server_stream_buffer_bytes = 262144;

statement ok
CREATE SECRET (TYPE quack, TOKEN 'asdf');

# The server runs the sort and serves the first batch; the one client thread stalls on the first row,
# past the TTL, with the sorted tail left on the server, and its next FETCH runs the sweep that expires it.
statement ok
SET threads = 1;

statement error
SELECT count(*) FROM (
  SELECT s, sleep_ms(CASE WHEN s = '0' THEN 2000 ELSE 0 END) AS pause
  FROM quack_query({server}, 'SELECT * FROM big ORDER BY s', token=>'asdf')
) WHERE pause IS NULL;
----
Query was interrupted

statement ok
RESET threads;

query I quack_db:quack_server_con
SELECT count(cached_rows) FROM quack_active_connections() WHERE connection_id <> '{harness}';
----
0

# Dropping the cache released the query behind it, not just the rows it had retained.
query I quack_db:quack_server_con
SELECT memory_usage_bytes = 0 FROM duckdb_memory() WHERE tag = 'ORDER_BY';
----
true

statement ok quack_db:quack_server_con
RESET GLOBAL quack_target_batch_bytes;

statement ok quack_db:quack_server_con
RESET GLOBAL quack_server_stream_buffer_bytes;

include test/template/quack_teardown.test_template
