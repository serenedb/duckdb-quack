# name: test/sql/attach.test
# description: test rpc extension
# group: [sql]

include test/template/quack_setup.test_template

statement ok quack_db:quack_server_con
create schema moo;

statement ok quack_db:quack_server_con
create table fuu as select 42 as col0, 43 as col1;

statement ok quack_db:quack_server_con
create table moo.fuu2 as values(44, 45);

query II
from quack_query({server}, 'select 42, 43', token='asdf')
----
42	43

# we can attach with a straight token
statement ok
attach {server} as rpc2 (token 'asdf')

statement ok
detach rpc2;

statement ok
create secret (type quack, token 'asdf')

statement ok
attach {server} as rpc

statement error
from rpc.query('BEGIN; select 42; COMMIT;')
----
cannot insert multiple commands into a prepared statement

query II
from rpc.fuu;
----
42	43

query I
from rpc.query('select 42');
----
42

query I
from rpc.{server_schema}.fuu select col1 where col0=42 ;
----
43

query II
from rpc.{server_schema}.fuu where col0=43;
----

statement error
from rpc.yyyy
----
Table with name yyyy does not exist

statement error
from rpc.xxx.yyy;
----
schema "xxx" does not exist

query II
from rpc.moo.fuu2;
----
44	45

statement ok
create schema rpc.fuuschema;

query I
select count(*) from duckdb_schemas() where database_name='rpc' and schema_name='fuuschema';
----
1

statement ok
begin transaction


statement ok
create table rpc.fuu2(i integer);


statement ok
from rpc.fuu2;

statement ok
commit

statement ok
from rpc.fuu2;


statement ok
drop table rpc.fuu2;


statement ok
begin transaction

statement ok
create table rpc.fuu3(i integer);

statement ok
insert into rpc.fuu3 from range(10000);

query I
from rpc.fuu3 select count(i);
----
10000

statement ok
rollback

statement error
from rpc.fuu3;
----
not exist


statement ok
detach rpc;

statement error
detach rpc;
----
database not found

include test/template/quack_teardown.test_template
